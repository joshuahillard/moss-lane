# Moss Lane line-ending policy - pin LF for all text except Windows-specific files.
# Rationale: server runs Linux; deploy scripts, Python, and shell tooling must be LF.

# Default: auto-detect text, normalize to LF on commit, check out as-is
* text=auto eol=lf

# Explicit LF for anything server-executed or parsed by POSIX tools
*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.sql       text eol=lf
Dockerfile  text eol=lf
.env.example text eol=lf
.gitignore  text eol=lf

# Binary - never normalize
*.png       binary
*.jpg       binary
*.pdf       binary
*.ico       binary
*.db        binary
*.sqlite    binary
*.sqlite3   binary
